# =====================================================================
# AMAKURU - environment contract
# Copy this file to .env and fill in the values marked REQUIRED.
# Everything marked OPTIONAL has a safe default and can stay empty.
# Run `make doctor` after editing: it validates every value, tests the
# connections, and tells you exactly what is missing or wrong.
# Never commit .env. Tenant (university) credentials are NOT stored here;
# they are entered in the admin dashboard and stored encrypted in the database.
# =====================================================================

# ---------- 1. Application (REQUIRED) ----------
APP_NAME=Amakuru
APP_ENV=development                      # development | staging | production
APP_BASE_URL=http://localhost:3000       # public URL of the admin dashboard
API_BASE_URL=http://localhost:8000       # public URL of the API
WIDGET_BASE_URL=http://localhost:8000/widget   # where the embeddable widget script is served
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en                      # en | lg | nyn | sw

# ---------- 2. Secrets (REQUIRED) ----------
# Generate SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate ENCRYPTION_KEY: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# ---------- 3. Database: PostgreSQL 16 with pgvector (REQUIRED) ----------
# docker-compose creates this database for you with these defaults.
POSTGRES_USER=amakuru
POSTGRES_PASSWORD=change-me
POSTGRES_DB=amakuru
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If you leave DATABASE_URL empty it is built from the POSTGRES_* values above.
DATABASE_URL=
# When true, the API connects as amakuru_app (NOBYPASSRLS). Keep false for local
# migrations/seed with the owner role; set true before production.
USE_APP_ROLE=false

# ---------- 4. Redis: cache, rate limits, job queue (REQUIRED) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 5. First platform administrator (REQUIRED for first run) ----------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=                # minimum 12 characters; change after first login
SEED_DEMO_DATA=true                      # loads a demo university with sample answers

# ---------- 6. Language model (REQUIRED) ----------
# Any OpenAI-compatible endpoint works: Groq, Together, OpenRouter, Cerebras,
# a local vLLM or Ollama server. Groq is the default.
# Confirm the current model IDs in the provider console before going live.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_PRIMARY=openai/gpt-oss-120b    # writes grounded answers
LLM_MODEL_FAST=openai/gpt-oss-20b        # rewrites follow-ups, classifies, cheap tasks
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=400
LLM_TEMPERATURE=0
# Optional fallback used automatically when the primary provider fails or rate-limits.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- 7. Embeddings and reranking (OPTIONAL: defaults run on CPU) ----------
EMBEDDING_PROVIDER=local                 # local | openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu                     # cpu | cuda
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REMOTE_BASE_URL=
EMBEDDING_REMOTE_API_KEY=
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20
HF_TOKEN=                                # only if a model download requires it
MODEL_CACHE_DIR=./.models

# ---------- 8. Retrieval policy (OPTIONAL: calibrate with `make eval`) ----------
RETRIEVAL_TOP_K=30
RETRIEVAL_FINAL_K=4
SCORE_VERBATIM_THRESHOLD=0.82            # above this, return the approved answer as written
SCORE_ANSWER_THRESHOLD=0.60              # above this, compose a grounded answer
SCORE_CLARIFY_THRESHOLD=0.45             # above this, ask a clarifying question; below, hand off
ENABLE_SEMANTIC_CACHE=true
CACHE_TTL_SECONDS=86400

# ---------- 9. Local languages (OPTIONAL) ----------
TRANSLATION_PROVIDER=sunbird             # sunbird | fasiri | none
SUNBIRD_BASE_URL=https://api.sunbird.ai
SUNBIRD_API_TOKEN=
FASIRI_BASE_URL=
FASIRI_API_KEY=

# ---------- 10. WhatsApp (OPTIONAL: platform-level values only) ----------
# Each university's phone number ID and access token are added in the admin
# dashboard and stored encrypted. Only the shared app values live here.
WHATSAPP_ENABLED=false
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=              # check Meta's current version before use

# ---------- 11. Email for alerts, expiry reminders, handoffs (OPTIONAL) ----------
EMAIL_PROVIDER=smtp                      # smtp | resend | none
EMAIL_FROM="Amakuru <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---------- 12. File storage (OPTIONAL) ----------
STORAGE_BACKEND=local                    # local | s3
STORAGE_LOCAL_PATH=./.storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---------- 13. Security and privacy (sensible defaults) ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_TTL_MINUTES=60
REFRESH_TTL_DAYS=14
RATE_LIMIT_PER_MINUTE_SESSION=20
RATE_LIMIT_PER_MINUTE_IP=60
TRANSCRIPT_RETENTION_DAYS=90             # raw chat text is anonymised after this
ALLOW_EXTERNAL_AI_CALLS=true             # set false for fully self-hosted (sovereign) mode
REQUIRE_2FA_FOR_APPROVERS=true

# ---------- 14. Observability (OPTIONAL) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 15. Commercial defaults (OPTIONAL) ----------
DEFAULT_PLAN=starter                     # starter | campus | enterprise
